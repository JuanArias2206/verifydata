{
  "installCommand": "pip install -r requirements-vercel.txt",
  "framework": null,
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "env": {
    "VERIFYDATA_DB_PATH": "/tmp/verifydata.db",
    "VERIFYDATA_ENV": "production",
    "PYTHONUNBUFFERED": "1"
  }
}
