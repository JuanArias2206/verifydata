# =====================================================================
#  VerifyData — Variables de entorno (plantilla)
#  Copie a `.env` y rellene con secretos reales:  cp .env.example .env
#  `.env` está en .gitignore. El proceso también lee estas variables del
#  entorno del sistema (systemd/Docker), que tiene prioridad sobre .env.
# =====================================================================

# --- Secretos de captcha / LLM (rellenar solo los que vaya a usar) ---
ANTHROPIC_API_KEY=
CAPSOLVER_API_KEY=
TWOCAPTCHA_API_KEY=
ANTICAPTCHA_API_KEY=
WEBSHARE_API_KEY=

# --- RSales API (ventasremotas.com — perfil crediticio) ---
RSALES_API_KEY=
RSALES_CLIENT_ID=
RSALES_CLIENT_SECRET=
RSALES_BASE_URL=https://api.ventasremotas.com/v1

# --- Google Sheets (sincronización de datos) ---
GOOGLE_SHEETS_ID=1nBCNIaI_V78SQeyOZRDrhet0Oiw_I5FZsHk92aKIkEE
GOOGLE_SHEETS_CREDENTIALS=credentials/verifydata-sheets.json

# --- Auth simple (user/pass para login) ---
VERIFYDATA_USER=naprolab
VERIFYDATA_PASS=naprolab

# --- Entidad consultante (se envía en formularios que la exigen, p. ej.
# Policía — Inhabilidades Ley 1918) ---
VERIFYDATA_ENTITY_NIT=900000000-1
VERIFYDATA_ENTITY_NAME=VerifyData

# --- Modo demo (LOGIN_DISABLED=1 desactiva autenticación) ---
LOGIN_DISABLED=1
# LOGIN_DISABLED=0  ← para entornos reales (requiere SMTP/SSO configurado)

# --- Servidor ---
HOST=0.0.0.0
PORT=5070

# --- Entorno de ejecución ---
# "dev"/"development"/"local" habilita facilidades de desarrollo (p. ej. la API
# abierta si no hay VERIFYDATA_API_KEYS). CUALQUIER otro valor (o ausencia) se
# trata como PRODUCCIÓN: sin claves, la API responde 401 (fail-closed).
VERIFYDATA_ENV=production

# --- API keys del servicio (separadas por comas) ---
# OBLIGATORIO en producción. Sin claves, /api/v1/* responde 401 (fail-closed)
# salvo que VERIFYDATA_ENV=dev. Genere claves de 32+ caracteres aleatorios:
#   python3 -c "import secrets; print('vd_live_' + secrets.token_urlsafe(32))"
# Varias claves separadas por comas.
VERIFYDATA_API_KEYS=

# --- CORS: origen(es) permitido(s) para /api/v1 (obligatorio en prod) ---
# Dominio EXACTO del front que consume la API. NUNCA "*" con datos personales.
# Vacío = sin cabeceras CORS.
# VERIFYDATA_CORS_ORIGINS=https://verifydata.example.com

# --- Base de datos ---
# Por defecto SQLite en data/verifydata.db. Para PRODUCCIÓN, define DATABASE_URL
# con Postgres y db.py usará PostgreSQL + pool de conexiones automáticamente.
#   DATABASE_URL=postgresql://user:pass@host:5432/verifydata
# Ruta SQLite (solo si NO usas Postgres):
# VERIFYDATA_DB_PATH=/var/lib/verifydata/verifydata.db
#
# Pool de conexiones de Postgres. Dimensiona MAX según la concurrencia real:
# runs.py lanza 16-32 workers por búsqueda que consultan la BD.
# max >= pico de operaciones DB simultáneas; el resto se encola. Nunca por
# encima de max_connections de Postgres (default 100).
# VERIFYDATA_PG_POOL_MIN=2
# VERIFYDATA_PG_POOL_MAX=16
# VERIFYDATA_PG_POOL_TIMEOUT=30

# --- Retención de capturas/certificados en horas (0 = desactivar) ---
VERIFYDATA_RETENTION_HOURS=72

# --- Logging / auditoría ---
# Nivel de log (DEBUG/INFO/WARNING/ERROR). Los eventos de auditoría
# (búsquedas, logins, descargas de PDF, cambios de RBAC) salen siempre a stdout
# en JSON. Si se define VERIFYDATA_LOG_DIR, se escriben además app.log y
# audit.log rotados.
VERIFYDATA_LOG_LEVEL=INFO
# VERIFYDATA_LOG_DIR=/var/log/verifydata
# Retención de la tabla audit_log en días (0 = nunca purgar).
# Solo aplica con PostgreSQL.
# VERIFYDATA_AUDIT_RETENTION_DAYS=0

# --- Concurrencia (opcional; ver runs.py) ---
# VERIFYDATA_MAX_CONCURRENCY=12
# VERIFYDATA_MAX_BROWSER=3
# VERIFYDATA_PER_RUN_WORKERS=8
# VERIFYDATA_CACHE_TTL_S=300
# VERIFYDATA_HTTP_THREADS=16
